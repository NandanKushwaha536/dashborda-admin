# Backend API the admin talks to (through its own /api/backend proxy).
BACKEND_API_URL=https://your-backend.onrender.com/api/v1

# Same value as PROXY_SHARED_SECRET on the backend (openssl rand -hex 32).
# Lets the backend count rate limits per real staff member instead of per website server.
PROXY_SHARED_SECRET=

# Leave empty: the browser calls /api/backend on this same site.
NEXT_PUBLIC_API_BASE_URL=
